index 0000000..f19ee7b
--- /dev/null
+++ b/qmk_cli/intercepts/userspace_add.py
@@ -0,0 +1,70 @@
+"""`qmk userspace-add --alt-home <name>` intercept.
+
+Only intercepts when `--alt-home` is supplied; without it the firmware-side
+userspace-add runs unchanged. This handler appends an entry of the form
+`[keyboard, keymap, {"alt_home": name, ...env}]` to the userspace `qmk.json`
+without touching the firmware tree -- so the named alt_home does not need to
+be present (or even reachable) when the entry is added.
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+from ..helpers import find_qmk_userspace, is_qmk_userspace
+
+
+def _build_parser():
+    parser = argparse.ArgumentParser(prog='qmk userspace-add', add_help=False)
+    parser.add_argument('-kb', '--keyboard', required=True)
+    parser.add_argument('-km', '--keymap', required=True)
+    parser.add_argument('-e', '--env', action='append', default=[],
+                        help='VAR=VALUE pairs forwarded to make.')
+    parser.add_argument('--alt-home', dest='alt_home', required=True,
+                        help='Name of the alternate qmk_firmware tree to use for this target. Must match a configured user.qmk_alt_home.<name>.')
+    return parser
+
+
+def _parse_env_pairs(pairs):
+    out = {}
+    for entry in pairs:
+        if '=' not in entry:
+            print(f'Warning: ignoring env entry {entry!r} (expected VAR=VALUE).', file=sys.stderr)
+            continue
+        key, value = entry.split('=', 1)
+        out[key] = value
+    return out
+
+
+def run(argv):
+    parser = _build_parser()
+    args, _unknown = parser.parse_known_args(argv[1:])  # argv[0] is 'userspace-add'
+
+    userspace = find_qmk_userspace()
+    if not is_qmk_userspace(userspace):
+        print('Error: could not determine QMK userspace location.', file=sys.stderr)
+        return 1
+
+    qmk_json = Path(userspace) / 'qmk.json'
+    try:
+        data = json.loads(qmk_json.read_text(encoding='UTF-8'))
+    except json.JSONDecodeError as exc:
+        print(f'Error: {qmk_json} is not valid JSON: {exc}', file=sys.stderr)
+        return 1
+
+    env_dict = _parse_env_pairs(args.env)
+    env_dict['alt_home'] = args.alt_home
+    new_entry = [args.keyboard, args.keymap, env_dict]
+
+    targets = data.setdefault('build_targets', [])
+
+    # Reject exact duplicates, but allow same keyboard:keymap with different env.
+    if new_entry in targets:
+        print(f'{args.keyboard}:{args.keymap} (alt_home={args.alt_home}) is already a userspace build target.')
+        return 0
+
+    targets.append(new_entry)
+
+    qmk_json.write_text(json.dumps(data, indent=4) + '\n', encoding='UTF-8')
+    print(f'Added {args.keyboard}:{args.keymap} (alt_home={args.alt_home}) to userspace build targets.')
+    return 0
