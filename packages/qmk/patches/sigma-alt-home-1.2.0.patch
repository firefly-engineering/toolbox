+    if userspace_path is None:
+        return []
+
+    qmk_json = Path(userspace_path) / 'qmk.json'
+    if not qmk_json.exists():
+        return []
+
+    try:
+        data = json.loads(qmk_json.read_text(encoding='UTF-8'))
+    except json.JSONDecodeError:
+        return []
+
+    targets = []
