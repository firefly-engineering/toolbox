+def find_alt_home(name):
+    """Resolve a named alternate qmk_firmware path from user config.
+
+    Looks up `user.qmk_alt_home.<name>` across the storage shapes milc may use:
+    a top-level section literally named ``user.qmk_alt_home`` (how
+    RawConfigParser stores ``[user.qmk_alt_home]`` from qmk.ini), then a
+    nested-namespace attribute on the ``user`` section, then a flat
+    dotted/underscored key on the ``user`` section as a fallback.
+
+    Returns a resolved Path or None if not configured.
+    """
+    if not name:
+        return None
+
+    path_str = None
+
+    # Flat INI section: cli.config['user.qmk_alt_home'][<name>]. milc's
+    # RawConfigParser keeps the literal dotted section name as a single key,
+    # so this is what an entry written to qmk.ini under [user.qmk_alt_home]
+    # actually lands as.
+    try:
+        flat_section = cli.config['user.qmk_alt_home']
+    except (KeyError, AttributeError, TypeError):
+        flat_section = None
+    if flat_section is not None and name in flat_section:
+        try:
+            candidate = flat_section[name]
+        except (KeyError, TypeError):
+            candidate = None
+        if isinstance(candidate, str) and candidate:
+            path_str = candidate
+
+    if not path_str:
+        section = getattr(cli.config.user, 'qmk_alt_home', None)
+        if section is not None:
+            # Nested namespace: cli.config.user.qmk_alt_home.<name>
+            path_str = getattr(section, name, None)
+            if path_str is None and hasattr(section, '__getitem__'):
+                try:
+                    path_str = section[name]
+                except (KeyError, TypeError):
+                    path_str = None
+
+    if not path_str:
+        # Flat dotted key on the user section
+        try:
+            path_str = cli.config['user'].get(f'qmk_alt_home.{name}')
+        except (AttributeError, TypeError):
+            path_str = None
+
+    if not path_str:
+        # Underscore fallback for environments that mangle dotted keys
+        path_str = getattr(cli.config.user, f'qmk_alt_home_{name}', None)
+
+    if not path_str:
+        return None
+
+    return Path(path_str).expanduser().resolve()
