+def load_userspace_targets(userspace_path):
+    """Return a list of build_target dicts parsed from a userspace `qmk.json`.
+
+    Each dict has `keyboard` and `keymap`, and optionally `env` (the dict of
+    pass-through make variables, with reserved keys stripped out) and one entry
+    per reserved key (e.g. `alt_home`). JSON-path entries are returned as
+    `{'json_path': str}`.
