@@ -0,0 +1,80 @@
+"""`qmk userspace-compile` intercept.
+
+Replaces the firmware-side userspace_compile for the duration of the wrapper
+invocation. Reads `qmk.json`, then spawns a `qmk compile` per build target so
+each one resolves its own QMK_HOME via the alt_home machinery in script_qmk.
+"""
+import argparse
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+from ..helpers import find_qmk_userspace, is_qmk_userspace, load_userspace_targets
+
+
+def _build_parser():
+    parser = argparse.ArgumentParser(prog='qmk userspace-compile', add_help=False)
+    parser.add_argument('-c', '--clean', action='store_true')
+    parser.add_argument('-n', '--dry-run', action='store_true')
+    parser.add_argument('-p', '--print-failures', action='store_true')
+    parser.add_argument('-e', '--env', action='append', default=[])
+    # Accepted for parity with firmware-side userspace-compile; not currently
+    # honored by this intercept.
+    parser.add_argument('-j', '--parallel', type=int, default=1)
+    parser.add_argument('-t', '--no-temp', action='store_true')
+    return parser
+
+
+def _qmk_invocation():
+    """Return the argv prefix used to re-enter the wrapper."""
+    return [sys.argv[0]]
+
+
+def _compile_command(target, extra_env, clean, dry_run):
+    cmd = _qmk_invocation() + ['compile']
+    if 'json_path' in target:
+        userspace = Path(os.environ.get('QMK_USERSPACE', '.'))
+        cmd.append(str(userspace / target['json_path']))
+    else:
+        cmd += ['-kb', target['keyboard'], '-km', target['keymap']]
+        for key, value in target.get('env', {}).items():
+            cmd += ['-e', f'{key}={value}']
+    for entry in extra_env:
+        cmd += ['-e', entry]
+    if clean:
+        cmd.append('-c')
+    if dry_run:
+        cmd.append('-n')
+    return cmd
+
+
+def run(argv):
+    parser = _build_parser()
+    args, _unknown = parser.parse_known_args(argv[1:])  # argv[0] is 'userspace-compile'
+
+    userspace = find_qmk_userspace()
+    if not is_qmk_userspace(userspace):
+        print('Error: could not determine QMK userspace location.', file=sys.stderr)
+        return 1
+
+    targets = load_userspace_targets(userspace)
+    if not targets:
+        print('No build targets found in qmk.json.', file=sys.stderr)
+        return 0
+
+    failures = []
+    for target in targets:
+        label = target.get('json_path') or f"{target['keyboard']}:{target['keymap']}"
+        cmd = _compile_command(target, args.env, args.clean, args.dry_run)
+        print(f'>>> {label}')
+        result = subprocess.run(cmd)
+        if result.returncode != 0:
+            failures.append((label, result.returncode))
+
+    if failures:
+        print(f'\n{len(failures)} target(s) failed:', file=sys.stderr)
+        for label, code in failures:
+            print(f'  {label} (exit {code})', file=sys.stderr)
+        return 1
+    return 0
