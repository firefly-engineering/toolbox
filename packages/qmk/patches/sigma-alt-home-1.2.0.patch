--- /dev/null
+++ b/qmk_cli/intercepts/__init__.py
@@ -0,0 +1,44 @@
+"""CLI-wrapper-level intercepts for subcommands that need alt_home dispatch.
+
+These run before milc.cli() and before the firmware-side qmk.cli is imported.
+Each intercept reads userspace state directly (via qmk_cli.helpers) and shells
+out to `qmk <subcommand>` invocations that re-enter the wrapper, where the
+per-target QMK_HOME is resolved by script_qmk._resolve_alt_home_for_argv.
+"""
+import sys
+
+
+def _first_positional(argv):
+    for arg in argv:
+        if not arg.startswith('-'):
+            return arg
+    return None
+
+
+def detect_intercept(argv):
+    """Return the name of an intercepted subcommand if argv invokes one, else None.
+
+    Skipped if --help/-h is present so milc-driven help output still works.
+    `userspace-add` is only intercepted when `--alt-home` is in argv; without it
+    we let the firmware-side implementation handle the call unchanged.
+    """
+    if any(a in ('-h', '--help') for a in argv):
+        return None
+
+    subcommand = _first_positional(argv)
+    if subcommand == 'userspace-compile':
+        return 'userspace-compile'
+    if subcommand == 'userspace-add' and '--alt-home' in argv:
+        return 'userspace-add'
+    return None
+
+
+def dispatch(name):
+    """Run the named intercept handler and return its exit code (int)."""
+    if name == 'userspace-compile':
+        from . import userspace_compile
+        return userspace_compile.run(sys.argv[1:])
+    if name == 'userspace-add':
+        from . import userspace_add
+        return userspace_add.run(sys.argv[1:])
+    raise ValueError(f'No intercept registered for {name!r}')
